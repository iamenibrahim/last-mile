{
  "swagger": "2.0",
  "info": {
    "title": "Last-Mile Caseworker Tools",
    "description": "Read-only caseworker tools. GetHandoff returns a resident's signed Last-Mile action packet by its RBX recovery code; SearchSourceQuotes returns exact sentences from saved agency pages. Nothing is generated, and neither decides eligibility.",
    "version": "1.0"
  },
  "host": "lmva3fcshw5lauukqapi.azurewebsites.net",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/handoff/{code}": {
      "get": {
        "operationId": "GetHandoff",
        "summary": "Get a resident handoff by recovery code",
        "description": "Use when a caseworker gives a recovery code that looks like RBX-XXXXX. Returns the resident's county, disaster, needs, cited next steps, deadlines, and whether the packet signature verified.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The resident's recovery code, for example RBX-7K2QM.",
            "x-ms-summary": "Recovery code"
          }
        ],
        "responses": {
          "200": {
            "description": "Handoff summary",
            "schema": {
              "$ref": "#/definitions/Handoff"
            }
          },
          "404": {
            "description": "Recovery code not found or expired (codes last 24 hours)."
          }
        }
      }
    },
    "/grounded/api/quotes/search": {
      "get": {
        "operationId": "SearchSourceQuotes",
        "summary": "Find exact sentences in FEMA, eCFR, SBA and SAMHSA pages",
        "description": "Use when the caseworker asks what an agency says about a topic. Returns only exact sentences from saved, hash-verified agency pages, each with its source URL. Quote them word for word.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "What to look for, for example 'appeal a decision'.",
            "x-ms-summary": "Topic"
          },
          {
            "name": "top",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 5,
            "description": "How many sentences, 1 to 10.",
            "x-ms-summary": "Count"
          }
        ],
        "responses": {
          "200": {
            "description": "Exact quotes",
            "schema": {
              "$ref": "#/definitions/QuoteSearch"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Handoff": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "packet_id": {
          "type": "string"
        },
        "packet_verified": {
          "type": "boolean",
          "description": "False means the packet failed its signature check and must not be relied on."
        },
        "jurisdiction": {
          "type": "string"
        },
        "disaster_id": {
          "type": "string"
        },
        "disaster_name": {
          "type": "string"
        },
        "snapshot_notice": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escalation_required": {
          "type": "boolean"
        },
        "escalation_topic": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "caller_summary": {
          "type": "string"
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "display": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "integer"
              },
              "label": {
                "type": "string"
              },
              "confidence": {
                "type": "string"
              },
              "current_limit": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              }
            }
          }
        },
        "boundary": {
          "type": "string"
        }
      }
    },
    "QuoteSearch": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "doc_id": {
                "type": "string"
              },
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              }
            }
          }
        },
        "boundary": {
          "type": "string"
        }
      }
    }
  }
}
