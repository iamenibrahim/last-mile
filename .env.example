APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000
NWS_USER_AGENT=LastMileNavigator/1.0 (contact@example.org)
MANIFEST_SIGNING_KEY=replace-with-a-key-vault-backed-secret

# Microsoft Foundry Models API (OpenAI-compatible v1 endpoint)
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=gpt-4.1-mini

# Foundry Tools / Azure AI services
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_CONTENT_SAFETY_ENDPOINT=https://YOUR-CONTENT-SAFETY.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=
AZURE_MAPS_KEY=

# Data and signing targets
AZURE_COSMOS_ENDPOINT=
AZURE_KEY_VAULT_URL=

# Azure Communication Services SMS. Sending and automatic replies are opt-in switches.
AZURE_COMMUNICATION_ENDPOINT=https://YOUR-RESOURCE.communication.azure.com
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_SMS_FROM_NUMBER=
SMS_SEND_ENABLED=false
SMS_AUTOREPLY_ENABLED=false
# Optional comma-separated E.164 numbers for a tightly scoped student pilot.
SMS_ALLOWED_TEST_RECIPIENTS=

# Azure Communication Services Call Automation. Trial voice calls work only with
# the ACS trial number and recipient numbers verified in Azure. Calls are opt-in.
AZURE_CALL_FROM_NUMBER=
CALL_START_ENABLED=false
CALL_ALLOWED_TEST_RECIPIENTS=
AZURE_CALL_COGNITIVE_ENDPOINT=https://YOUR-AI-SERVICES.cognitiveservices.azure.com
AZURE_CALL_VOICE_NAME=en-US-JennyNeural
AZURE_CALL_SOURCE_LOCALE=en-US
