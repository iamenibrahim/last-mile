APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000
NWS_USER_AGENT=LastMileNavigator/1.0 (contact@example.org)
MANIFEST_SIGNING_KEY=replace-with-a-key-vault-backed-secret

# Microsoft Foundry Models API (OpenAI-compatible v1 endpoint)
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=gpt-4.1-mini

# Foundry Tools / Azure AI services
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_CONTENT_SAFETY_ENDPOINT=https://YOUR-CONTENT-SAFETY.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=
AZURE_MAPS_KEY=

# Data and signing targets
AZURE_COSMOS_ENDPOINT=
AZURE_KEY_VAULT_URL=

